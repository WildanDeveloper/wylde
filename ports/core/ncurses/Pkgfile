name=ncurses
version=6.6
description="Library for text-based user interfaces"
license=MIT
source=https://ftp.gnu.org/gnu/ncurses/ncurses-$version.tar.gz
checksum(https://ftp.gnu.org/gnu/ncurses/ncurses-$version.tar.gz)=355b4cbbed880b0381a04c46617b7656e362585d52e9cf84a67e2009b749ff11

build() {
    mkdir build
     pushd build
       ../configure --prefix="$PKG"/tools AWK=gawk
       make -C include
       make -C progs tic
       install progs/tic "$PKG"/tools/bin
     popd
     ./configure --prefix=/usr \
                      --mandir=/usr/share/man \
                      --with-manpage-format=normal \
                      --with-shared \
                      --without-normal \
                      --with-cxx-shared \
                      --without-debug \
                      --without-ada \
                      --disable-stripping \
                      AWK=gawk
     make
     make DESTDIR="$PKG" install
     ln -sv libncursesw.so "$PKG/usr/lib/libncurses.so
     sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$PKG/usr/include/curses.h
}
