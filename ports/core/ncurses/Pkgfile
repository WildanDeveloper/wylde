name=ncurses
version=6.6
description="Library for text-based user interfaces"
license=MIT
source=https://invisible-island.net/archives/ncurses/current/ncurses-$version-20260926.tgz
checksum(https://invisible-island.net/archives/ncurses/current/ncurses-$version-20260926.tgz)=bc3ed46986165c0f69ab4b2b2c04907d4b042be35e18e35aeea9c80e0e292ac6

build() {
    mkdir build
     pushd build
       ../configure --prefix="$PKG"/tools AWK=gawk
       make -C include
       make -C progs tic
       install progs/tic "$PKG"/tools/bin
     popd
     ./configure --prefix=/usr \
                      --mandir=/usr/share/man \
                      --with-manpage-format=normal \
                      --with-shared \
                      --without-normal \
                      --with-cxx-shared \
                      --without-debug \
                      --without-ada \
                      --disable-stripping \
                      AWK=gawk
     make
     make DESTDIR="$PKG" install
     ln -sv libncursesw.so "$PKG/usr/lib/libncurses.so
     sed -e 's/^#if.*XOPEN.*$/#if 1/' -i "$PKG/usr/include/curses.h
}
