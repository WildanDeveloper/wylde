name=util-linux
version=2.41.1
description="Standard system utilities"
license=GPL-2.0-or-later
source=https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-$version.tar.xz
checksum(https://www.kernel.org/pub/linux/utils/util-linux/v2.41/util-linux-$version.tar.xz)=be9ad9a276f4305ab7dd2f5225c8be1ff54352f565ff4dede9628c1aaa7dec57
depends="ncurses"

build() {
    mkdir -pv "$PKG/var/lib/hwclock"
     ./configure --libdir=/usr/lib     \
                 --runstatedir=/run    \
                 --disable-chfn-chsh   \
                 --disable-login       \
                 --disable-nologin     \
                 --disable-su          \
                 --disable-setpriv     \
                 --disable-runuser     \
                 --disable-pylibmount  \
                 --disable-static      \
                 --disable-liblastlog2 \
                 --without-python      \
                 ADJTIME_PATH=/var/lib/hwclock/adjtime \
                 --docdir=/usr/share/doc/util-linux-2.41.1
     make
     make DESTDIR="$PKG" install
}
