name=binutils-pass1
version=2.45
description="Binutils, first cross pass: assembler and linker for the target toolchain" license=GPL-3.0-or-later
source=https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz
checksum(https://ftp.gnu.org/gnu/binutils/binutils-$version.tar.xz)=c50c0e7f9cb188980e2cc97e4537626b1672441815587f1eab69d2a1bfbef5d2

build() {
    # Wylde builds on the same architecture it targets (see docs/build-notes.md),
    # so the cross triplet is derived, not hardcoded.
    LFS_TGT=$(uname -m)-lfs-linux-gnu
    mkdir -v build
    cd       build
    ../configure --prefix=/tools \
                 --with-sysroot=/ \
                 --target="$LFS_TGT" \
                 --disable-nls \
                 --enable-gprofng=no \
                 --disable-werror \
                 --enable-new-dtags \
                 --enable-default-hash-style=gnu
    make
    make DESTDIR="$PKG" install
}
