name=gettext
version=0.26
description="GNU internationalization utilities and runtime"
license=GPL-3.0-or-later
source=https://ftp.gnu.org/gnu/gettext/gettext-$version.tar.xz
checksum(https://ftp.gnu.org/gnu/gettext/gettext-$version.tar.xz)=d1fb86e260cfe7da6031f94d2e44c0da55903dbae0a2fa0fae78c91ae1b56f00
depends="ncurses"

build() {
    ./configure --prefix=/usr --disable-shared --disable-java --disable-csharp --disable-nls
     make
     make DESTDIR="$PKG" install
     find "$PKG" -name '*.la' -delete
}
