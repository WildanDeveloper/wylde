name=bzip2
version=1.0.8
description="High-quality data compressor"
license=bzip2-1.0.6
source=https://sourceware.org/pub/bzip2/bzip2-$version.tar.gz
checksum(https://sourceware.org/pub/bzip2/bzip2-$version.tar.gz)=ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269
patches=https://www.linuxfromscratch.org/patches/lfs/12.4/bzip2-$version-install_docs-1.patch
checksum(https://www.linuxfromscratch.org/patches/lfs/12.4/bzip2-$version-install_docs-1.patch)=35e3bbd9642af51fef2a8a83afba040d272da42d7e3a251d8e43255a7b496702
depends=zlib

build() {
    mkdir -pv "$PKG/usr/bin" "$PKG/usr/lib"
    patch -Np1 -i "$PATCHDIR/bzip2-1.0.8-install_docs-1.patch"
    sed -i 's@\(ln -s -f \)$(PREFIX)/bin/@\1@' Makefile
    sed -i "s@(PREFIX)/man@(PREFIX)/share/man@g" Makefile
    make -f Makefile-libbz2_so
    make clean
    make
    make PREFIX=/usr DESTDIR="$PKG" install
    cp -av libbz2.so.* "$PKG/usr/lib"
    ln -sv libbz2.so.1.0.8 "$PKG/usr/lib/libbz2.so"
    cp -v bzip2-shared "$PKG/usr/bin/bzip2"
    for i in bzcat bunzip2; do ln -sfv bzip2 "$PKG/usr/bin/$i"; done
    rm -fv "$PKG/usr/lib/libbz2.a"
}
