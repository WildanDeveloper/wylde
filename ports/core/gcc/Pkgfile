name=gcc
version=15.2.0
description="GCC, final pass: the C and C++ compiler Wylde ships" license=GPL-3.0-or-later
srcdir=gcc-$version
source=https://ftp.gnu.org/gnu/gcc/gcc-$version/gcc-$version.tar.xz https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz
checksum(https://ftp.gnu.org/gnu/gcc/gcc-$version/gcc-$version.tar.xz)=438fd996826b0c82485a29da03a72d71d6e3541a83ec702df4271f6fe025d24e
checksum(https://ftp.gnu.org/gnu/mpfr/mpfr-4.2.2.tar.xz)=b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01
checksum(https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz)=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
checksum(https://ftp.gnu.org/gnu/mpc/mpc-1.3.1.tar.gz)=ab642492f5cf882b74aa0cb730cd410a81edcdbec895183ce930e706c1c759b8
depends="binutils-pass2 glibc libstdcpp-pass1"

build() {
    LFS_TGT=$(uname -m)-lfs-linux-gnu
    for d in ../gmp-* ../mpfr-* ../mpc-*; do
        [ -d "$d" ] || continue
        inner=$(basename "$d")
        mv "$d" "./${inner%%-*}"
    done
    case $(uname -m) in
        x86_64)
            sed -e '/m64=/s/lib64/lib/' \
                -i.orig gcc/config/i386/t-linux64
        ;;
    esac
    sed '/thread_header =/s/@.*@/gthr-posix.h/' \
        -i libgcc/Makefile.in libstdc++-v3/include/Makefile.in
    mkdir -v build
    cd       build
    ../configure                   \
        --build=$(../config.guess) \
        --host="$LFS_TGT"          \
        --target="$LFS_TGT"        \
        --prefix=/usr              \
        --with-build-sysroot=/     \
        --enable-default-pie       \
        --enable-default-ssp       \
        --disable-nls              \
        --disable-multilib         \
        --disable-libatomic        \
        --disable-libgomp          \
        --disable-libquadmath      \
        --disable-libsanitizer     \
        --disable-libssp           \
        --disable-libvtv           \
        --enable-languages=c,c++   \
        LDFLAGS_FOR_TARGET=-L$PWD/../../$LFS_TGT/libgcc
    make
    make DESTDIR="$PKG" install
    ln -sv gcc "$PKG/usr/bin/cc"
    find "$PKG" -name '*.a' -exec strip --strip-unneeded {} + 2>/dev/null || true
}
