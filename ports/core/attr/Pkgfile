name=attr
version=2.5.2
description="Extended attributes filesystem tool"
license=LGPL-2.1-or-later
source=https://download.savannah.nongnu.org/releases/attr/attr-$version.tar.gz
checksum(https://download.savannah.nongnu.org/releases/attr/attr-$version.tar.gz)=39bf67452fa41d0948c2197601053f48b3d78a029389734332a6309a680c6c87

build() {
    ./configure --prefix=/usr \
                 --disable-static  \
                 --sysconfdir=/etc \
                 --docdir=/usr/share/doc/attr-2.5.2
     make
     make DESTDIR="$PKG" install
}
