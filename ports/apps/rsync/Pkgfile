name=rsync
version=3.5.1
description="Efficient file transfer, local and remote"
license=GPL-3.0-or-later
source=https://download.samba.org/pub/rsync/src/rsync-$version.tar.gz
checksum(https://download.samba.org/pub/rsync/src/rsync-$version.tar.gz)=c55f9c9dc10fb8bec397b399a0fdded53cc9a2d8e30891bb0d63724d25c37bef

build() {
    ./configure --prefix=/usr     \
                --sysconfdir=/etc \
                --disable-md2man   \
                --disable-man     \
                --disable-idn
    make
    make DESTDIR="$PKG" install
}
