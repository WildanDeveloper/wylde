name=procps
version=4.0.5
description="Process utilities: ps, free, pgrep, sysctl"
license=GPL-2.0-or-later
source=https://gitlab.com/procps-ng/procps/-/archive/v$version/procps-v$version.tar.gz
checksum(https://gitlab.com/procps-ng/procps/-/archive/v$version/procps-v$version.tar.gz)=2c6d7ed9f2acde1d4dd4602c6172fe56eff86953fe8639bd633dbd22cc18f5db
depends="ncurses autoconf automake gettext"
srcdir=procps-v$version

build() {
    ./autogen.sh
     ./configure --prefix=/usr                    \
                 --disable-static                 \
                 --disable-kill                   \
                 --enable-watch8bit
     make
     make DESTDIR="$PKG" install
}
