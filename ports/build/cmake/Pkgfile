name=cmake
version=4.4.3
description="Cross-platform, open-source build system generator"
license=BSD-3-Clause
source=https://github.com/Kitware/CMake/releases/download/v$version/cmake-$version.tar.gz
checksum(https://github.com/Kitware/CMake/releases/download/v$version/cmake-$version.tar.gz)=c46400618b4f1f2b43507f24fb22f3ae830c3416cf23b776e16e1d413aa892f0

build() {
    # Wylde builds with make and gcc only: no Qt, no curses GUI, no Fortran
    ./bootstrap --prefix=/usr                 --parallel=$(nproc)                 --no-system-libs                 --no-qt-gui
    make
    make DESTDIR="$PKG" install
    find "$PKG" -name '*.so' -type f -exec strip --strip-unneeded {} + 2>/dev/null || true
}
