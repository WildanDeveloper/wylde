name=pyyaml
version=6.0.3
description="YAML parser for Python; the base Python has no pip, so only the pure-Python part is installed"
license=MIT
source=https://github.com/yaml/pyyaml/archive/refs/tags/$version.tar.gz
checksum(https://github.com/yaml/pyyaml/archive/refs/tags/$version.tar.gz)=c7b45011e052458ae79015d5eea3046c37d099023d4b253dde26ee1c29ea2f36
srcdir=pyyaml-$version

build() {
    mkdir -p "$PKG/usr/lib/python3.13/site-packages"
     cp -r "$SRCDIR/lib/yaml" "$PKG/usr/lib/python3.13/site-packages/"
}
