name=libxml2
version=2.14.5
description="XML parser; the Wayland server and labwc's menu both want it"
license=MIT
source=https://download.gnome.org/sources/libxml2/2.14/libxml2-$version.tar.xz
checksum(https://download.gnome.org/sources/libxml2/2.14/libxml2-$version.tar.xz)=03d006f3537616833c16c53addcdc32a0eb20e55443cba4038307e3fa7d8d44b
depends="python"

build() {
    ./autogen.sh --prefix=/usr --without-python --with-html=man --with-modules
     make
     make DESTDIR="$PKG" install
     find "$PKG" -name '*.la' -delete
}
