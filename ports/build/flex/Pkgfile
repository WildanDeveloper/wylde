name=flex
version=2.6.4
description="Fast lexical analyser generator"
license=BSD-2-Clause
source=https://github.com/westes/flex/releases/download/v$version/flex-$version.tar.gz
checksum(https://github.com/westes/flex/releases/download/v$version/flex-$version.tar.gz)=e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995
depends="bison m4"

build() {
    ./configure --prefix=/usr \
                 --docdir=/usr/share/doc/flex-2.6.4 \
                 --disable-static
     make
     make DESTDIR="$PKG" install
     ln -sv flex "$PKG/usr/bin/lex"
}
