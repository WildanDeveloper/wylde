name=glib
version=2.84.4
description="Foundational library for GNOME software; labwc's toolkit"
license=LGPL-2.1-or-later
source=https://download.gnome.org/sources/glib/2.84/glib-$version.tar.xz
checksum(https://download.gnome.org/sources/glib/2.84/glib-$version.tar.xz)=8a9ea10943c36fc117e253f80c91e477b673525ae45762942858aef57631bb90
depends="libffi pcre2 zlib meson ninja"

build() {
    meson setup build --prefix=/usr --buildtype=plain -Dintrospection=disabled -Dtests=false -Dman-pages=disabled -Dglib_debug=disabled
     ninja -C build
     DESTDIR="$PKG" ninja -C build install
}
