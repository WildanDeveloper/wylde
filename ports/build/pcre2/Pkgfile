name=pcre2
version=10.48
description="Regular expression library, needed by glib"
license=BSD-3-Clause
source=https://deb.debian.org/debian/pool/main/p/pcre2/pcre2_$version.orig.tar.gz
checksum(https://deb.debian.org/debian/pool/main/p/pcre2/pcre2_$version.orig.tar.gz)=ebcc25aadf2a51fa1fefa9b8bc9e7a79b3dae86870a0f1152a22e42befd46888
depends=""

build() {
    ./configure --prefix=/usr --disable-static --enable-jit --enable-pcre2-16 --enable-pcre2-32 --enable-pcre2grep-jit
     make
     make DESTDIR="$PKG" install
     find "$PKG" -name '*.la' -delete
}
