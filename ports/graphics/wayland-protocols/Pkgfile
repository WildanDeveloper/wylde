name=wayland-protocols
version=1.49
description="Interface definitions every Wayland component shares"
license=MIT
source=https://deb.debian.org/debian/pool/main/w/wayland-protocols/wayland-protocols_$version.orig.tar.xz
checksum(https://deb.debian.org/debian/pool/main/w/wayland-protocols/wayland-protocols_$version.orig.tar.xz)=ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14
depends="meson ninja"
srcdir=wayland-protocols-$version

build() {
    meson setup build --prefix=/usr --buildtype=plain -Dtests=false
     ninja -C build
     DESTDIR="$PKG" ninja -C build install
}
