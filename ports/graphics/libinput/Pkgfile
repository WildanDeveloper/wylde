name=libinput
version=1.32.0
description="Turns raw input events into touch, tablet and pointer gestures"
license=LGPL-2.1-or-later
source=https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.gz
checksum(https://gitlab.freedesktop.org/libinput/libinput/-/archive/$version/libinput-$version.tar.gz)=7dd6c1ca964c86eb6810ccd6639cda634e68bdca43bf3afec39e94e942fac8d4
depends="libevdev mtdev meson ninja"

build() {
    meson setup build --prefix=/usr --buildtype=plain -Ddocumentation=false -Dtests=false -Dlibwacom=false
     ninja -C build
     DESTDIR="$PKG" ninja -C build install
}
