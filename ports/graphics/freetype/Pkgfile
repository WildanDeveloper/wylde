name=freetype
version=2.14.1
description="Font rasteriser: without it there is no readable text anywhere"
license="FTL GPL-2.0-or-later"
source=https://download.savannah.gnu.org/releases/freetype/freetype-$version.tar.xz
checksum(https://download.savannah.gnu.org/releases/freetype/freetype-$version.tar.xz)=32427e8c471ac095853212a37aef816c60b42052d4d9e48230bab3bdf2936ccc

build() {
    ./configure --prefix=/usr --disable-static --with-zlib=yes --with-bzip2=yes
     make
     make DESTDIR="$PKG" install
     find "$PKG" -name '*.la' -delete
}
