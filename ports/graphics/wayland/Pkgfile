name=wayland
version=1.26.0
description="The Wayland compositor and client library"
license=MIT
source=https://deb.debian.org/debian/pool/main/w/wayland/wayland_$version.orig.tar.xz
checksum(https://deb.debian.org/debian/pool/main/w/wayland/wayland_$version.orig.tar.xz)=64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3
depends="libdrm wayland-protocols meson ninja libffi"
srcdir=wayland-$version

build() {
    meson setup build --prefix=/usr --buildtype=plain -Dtests=false -Ddocumentation=false -Ddocbook_validation=false -Ddtd_validation=false
     ninja -C build
     DESTDIR="$PKG" ninja -C build install
}
