name=wayland
version=1.26.0
description="The Wayland compositor and client library"
license=MIT
source=https://gitlab.freedesktop.org/wayland/wayland/-/archive/$version/wayland-$version.tar.gz
checksum(https://gitlab.freedesktop.org/wayland/wayland/-/archive/$version/wayland-$version.tar.gz)=56b3a985cbfe17a926e3bcf037e4d374f44eaa33f3a4b364549dddf0d324cebc
depends="libdrm wayland-protocols meson ninja libffi"

build() {
    meson setup build --prefix=/usr --buildtype=plain -Dtests=false -Ddocumentation=false -Ddocbook_validation=false -Ddtd_validation=false
     ninja -C build
     DESTDIR="$PKG" ninja -C build install
}
